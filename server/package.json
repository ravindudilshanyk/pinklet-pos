{
  "name": "@pinklet/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:integration:tx": "ts-node tests/billingRollback.ts",
    "test:integration:billing-service": "ts-node tests/billingServiceRollback.ts",
    "test:integration:waste": "ts-node tests/wasteRollback.ts",
    "test:integration": "pnpm test:integration:tx && pnpm test:integration:billing-service && pnpm test:integration:waste",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2"
  }
}